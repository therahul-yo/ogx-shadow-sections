{{ 'sl-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sl-sections.js' | asset_url }}" defer="defer"></script>
{% render 'sl-section-style', section: section %}
<section id="sl-{{ section.id }}" class="sl-section sl-stacks" aria-labelledby="sl-title-{{ section.id }}" style="--sl-product-columns: {{ section.settings.columns }}; --sl-promo-width: {{ section.settings.promo_width }}%; --sl-card-bg: {{ section.settings.card_background }}; --sl-card-text: {{ section.settings.card_text }}; --sl-price: {{ section.settings.price_color }};">
  <div class="sl-container sl-stacks__layout{% unless section.settings.show_promo %} sl-stacks__layout--no-promo{% endunless %}">
    <div class="sl-stacks__panel">
      <header class="sl-heading sl-heading--center sl-stacks__heading">
        <div class="sl-stacks__title">{% if section.settings.badge != blank %}<span class="sl-stacks__badge">{{ section.settings.badge | escape }}</span>{% endif %}<h2 id="sl-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
        {% if section.settings.subtitle != blank %}<p class="sl-stacks__subtitle"><span>{{ section.settings.subtitle | escape }}</span></p>{% endif %}
      </header>
      <div class="sl-stacks__products">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% render 'sl-product-card', card_product: block.settings.product, card_description: block.settings.description, card_key: block.id, block_attributes: block.shopify_attributes, section: section %}
          {% endfor %}
        {% elsif section.settings.collection != blank %}
          {% for card_product in section.settings.collection.products limit: section.settings.product_limit %}
            {% render 'sl-product-card', card_product: card_product, card_key: forloop.index, section: section %}
          {% else %}<p class="sl-empty">{{ section.settings.empty_collection_label | escape }}</p>{% endfor %}
        {% else %}
          {% render 'sl-product-card', section: section, card_key: 'empty' %}
        {% endif %}
      </div>
    </div>
    {% if section.settings.show_promo %}
      <aside class="sl-stacks__promo">
        {% if section.settings.promo_image != blank %}{{ section.settings.promo_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 1000px) 33vw, 100vw', class: 'sl-stacks__promo-image', alt: section.settings.promo_image.alt }}{% endif %}
        <div class="sl-stacks__promo-content">
          {% if section.settings.promo_heading != blank %}<h3>{{ section.settings.promo_heading | escape | newline_to_br }}</h3>{% endif %}
          {% assign promo_link = section.settings.promo_link | default: section.settings.collection.url %}
          {% if promo_link != blank and section.settings.promo_button != blank %}<a class="sl-stacks__explore" href="{{ promo_link }}">{{ section.settings.promo_button | escape }}{% render 'sl-icon', name: 'arrow' %}</a>{% endif %}
        </div>
      </aside>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Value stacks",
  "tag": "section",
  "class": "sl-section-host",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "MOST POPULAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VALUE STACKS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Better together. More results."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "paragraph",
      "content": "Product blocks take priority. Remove all product blocks to populate cards from the collection."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Collection product limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop product columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Promotion"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promotion",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promotion image"
    },
    {
      "type": "textarea",
      "id": "promo_heading",
      "label": "Promotion heading",
      "default": "“CONSISTENCY\nCREATES\nRESULTS”"
    },
    {
      "type": "text",
      "id": "promo_button",
      "label": "Promotion button",
      "default": "EXPLORE STACKS"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promotion link"
    },
    {
      "type": "range",
      "id": "promo_width",
      "label": "Promotion width",
      "min": 25,
      "max": 45,
      "step": 1,
      "default": 33,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Sale price",
      "default": "#f02e29"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "sold_label",
      "label": "Sold out label",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Savings label",
      "default": "Save"
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant selector label",
      "default": "Choose option"
    },
    {
      "type": "text",
      "id": "empty_product_label",
      "label": "Empty product heading",
      "default": "Choose a product"
    },
    {
      "type": "text",
      "id": "empty_product_description",
      "label": "Empty product description",
      "default": "Select a product in the theme editor."
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "NOT AVAILABLE"
    },
    {
      "type": "text",
      "id": "empty_collection_label",
      "label": "Empty collection message",
      "default": "No products in this collection yet."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "oswald_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#050805"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#b8b8b8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#42dd58"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 900,
      "max": 1900,
      "step": 20,
      "default": 1700,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Content gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 28,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description override (optional)"
