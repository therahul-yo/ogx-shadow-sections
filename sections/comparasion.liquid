{{ 'sl-sections.css' | asset_url | stylesheet_tag }}
{% render 'sl-section-style', section: section %}
<section id="sl-{{ section.id }}" class="sl-section sl-comparison" aria-labelledby="sl-title-{{ section.id }}" style="--sl-brand-bg: {{ section.settings.brand_background }}; --sl-brand-text: {{ section.settings.brand_text }}; --sl-intro-width: {{ section.settings.intro_width }}%;">
  <div class="sl-container sl-comparison__layout">
    <aside class="sl-comparison__intro">
      {% if section.settings.eyebrow != blank %}<p class="sl-comparison__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="sl-title-{{ section.id }}">{{ section.settings.heading | escape }}<span>{{ section.settings.heading_accent | escape }}</span></h2>
      {% if section.settings.description != blank %}<p class="sl-comparison__description">{{ section.settings.description | escape }}</p>{% endif %}
      <div class="sl-comparison__benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="sl-benefit" {{ block.shopify_attributes }}>
              <span class="sl-benefit__icon">{% render 'sl-icon', name: block.settings.icon %}</span>
              <div><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </aside>
    <div class="sl-comparison__scroll" role="region" aria-label="Product feature comparison" tabindex="0">
      <table class="sl-comparison__table">
        <caption class="sl-sr-only">{{ section.settings.brand_heading | escape }} {{ section.settings.table_caption | escape }}</caption>
        <thead><tr><th scope="col">{{ section.settings.feature_heading | escape }}</th><th scope="col" class="sl-comparison__brand">{{ section.settings.brand_heading | escape }}</th><th scope="col">{{ section.settings.other_heading | escape }}</th></tr></thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <tr {{ block.shopify_attributes }}>
                <th scope="row"><span class="sl-comparison__cell"><span class="sl-comparison__feature-icon">{% render 'sl-icon', name: block.settings.icon %}</span>{{ block.settings.title | escape }}</span></th>
                <td class="sl-comparison__brand"><span class="sl-comparison__cell"><span class="sl-comparison__status"><span class="sl-sr-only">{{ section.settings.positive_label | escape }}: </span>{% render 'sl-icon', name: 'check' %}</span>{{ block.settings.brand_value | escape }}</span></td>
                <td><span class="sl-comparison__cell"><span class="sl-comparison__status sl-comparison__status--other"><span class="sl-sr-only">{{ section.settings.negative_label | escape }}: </span>{% render 'sl-icon', name: 'cross' %}</span>{{ block.settings.other_value | escape }}</span></td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
